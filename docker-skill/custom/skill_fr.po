#: jellyfin_alexa_skill/alexa/handler/channel.py:31
msgid "Sorry, I can't find any channels with that name. Please try again."
msgstr "Désolé, je ne trouve aucune chaîne portant ce nom. Veuillez réessayer."

#: jellyfin_alexa_skill/alexa/handler/channel.py:83
msgid "Would you like to listen to {name} ?"
msgstr "Voulez-vous écouter {name} ?"

#: jellyfin_alexa_skill/alexa/handler/control.py:35
msgid "Sorry, I can't find any songs for this search. Please try again."
msgstr "Désolé, je ne trouve aucun titre pour cette recherche. Veuillez réessayer."

#: jellyfin_alexa_skill/alexa/handler/control.py:96
#: jellyfin_alexa_skill/alexa/handler/control.py:176
#: jellyfin_alexa_skill/alexa/handler/yesno.py:70
msgid "by {artist}"
msgstr "de {artist}"

#: jellyfin_alexa_skill/alexa/handler/control.py:98
msgid "Would you like to hear <break/> {title} {by_artist} ?"
msgstr "Voulez-vous écouter <break/> {title} {by_artist} ?"

#: jellyfin_alexa_skill/alexa/handler/control.py:120
msgid "Sorry, I can't find any videos for this search. Please try again."
msgstr "Désolé, je ne trouve aucune vidéo pour cette recherche. Veuillez réessayer."

#: jellyfin_alexa_skill/alexa/handler/control.py:129
msgid "I'm sorry, I can't play videos on this device."
msgstr "Désolé, cet appareil ne peut pas lire de vidéo."

#: jellyfin_alexa_skill/alexa/handler/control.py:178
msgid "Would you like to watch <break/> {title} {by_artist} ?"
msgstr "Voulez-vous regarder <break/> {title} {by_artist} ?"

#: jellyfin_alexa_skill/alexa/handler/control.py:200
msgid "Sorry, I can't find any songs with this artist. Please try again."
msgstr "Désolé, je ne trouve aucun titre pour cet artiste. Veuillez réessayer."

#: jellyfin_alexa_skill/alexa/handler/control.py:282
msgid "Sorry, I couldn't find any recently added media."
msgstr "Désolé, je n'ai trouvé aucun média récemment ajouté."

#: jellyfin_alexa_skill/alexa/handler/control.py:349
msgid "What can I play?"
msgstr "Que voulez-vous écouter ?"

#: jellyfin_alexa_skill/alexa/handler/control.py:414
msgid "You reached the end of the playback queue."
msgstr "Vous avez atteint la fin de la file de lecture."

#: jellyfin_alexa_skill/alexa/handler/control.py:452
msgid "You reached the start of the playback queue."
msgstr "Vous avez atteint le début de la file de lecture."

#: jellyfin_alexa_skill/alexa/handler/control.py:531
msgid "The playback queue is empty. Please try to add some media and try again."
msgstr "La file de lecture est vide. Veuillez ajouter des médias et réessayer."

#: jellyfin_alexa_skill/alexa/handler/error.py:28
msgid "Sorry, something went wrong. Please try again."
msgstr "Désolé, une erreur s'est produite. Veuillez réessayer."

#: jellyfin_alexa_skill/alexa/handler/event.py:114
msgid "Something went wrong during media playback. Please try again."
msgstr "Une erreur s'est produite pendant la lecture. Veuillez réessayer."

#: jellyfin_alexa_skill/alexa/handler/fallback.py:22
msgid "Sorry, I could not understand that. Please try again."
msgstr "Désolé, je n'ai pas compris. Veuillez réessayer."

#: jellyfin_alexa_skill/alexa/handler/favorite.py:57
msgid "Sorry, you don't have any favorite media."
msgstr "Désolé, vous n'avez aucun média dans vos favoris."

#: jellyfin_alexa_skill/alexa/handler/favorite.py:86
msgid "Added to your favorites."
msgstr "Ajouté à vos favoris."

#: jellyfin_alexa_skill/alexa/handler/favorite.py:88
#: jellyfin_alexa_skill/alexa/handler/favorite.py:118
msgid "There is currently no media playing."
msgstr "Aucun média n'est en cours de lecture."

#: jellyfin_alexa_skill/alexa/handler/favorite.py:116
msgid "Removed from your favorites."
msgstr "Retiré de vos favoris."

#: jellyfin_alexa_skill/alexa/handler/help.py:23
msgid ""
"With this skill your can play media from your Jellyfin Server. Use 'Play "
"Game of Live from Earth' or 'Play playlist this is number 42' to play "
"some songs."
msgstr ""
"Avec cette compétence, vous pouvez écouter votre musique Jellyfin. Dites "
"par exemple 'Joue Queen' ou 'Joue ma playlist favoris'."

#: jellyfin_alexa_skill/alexa/handler/info.py:29
msgid "Currently playing {title} from {artists}."
msgstr "Lecture en cours de {title} de {artists}."

#: jellyfin_alexa_skill/alexa/handler/info.py:32
msgid "Currently no media is played."
msgstr "Aucun média n'est en cours de lecture."

#: jellyfin_alexa_skill/alexa/handler/launch.py:39
msgid "Welcome to Jellyfin Player skill, what can I play?"
msgstr "Bienvenue sur votre NAS, que voulez-vous écouter ?"

#: jellyfin_alexa_skill/alexa/handler/launch.py:60
msgid "Sorry, this device does not support media playback."
msgstr "Désolé, cet appareil ne prend pas en charge la lecture audio."

#: jellyfin_alexa_skill/alexa/handler/playlist.py:37
msgid "Sorry, I couldn't find any playlist with this name. Please try again."
msgstr "Désolé, je ne trouve aucune playlist avec ce nom. Veuillez réessayer."

#: jellyfin_alexa_skill/alexa/handler/playlist.py:49
msgid "Sorry, this playlist does not exists anymore."
msgstr "Désolé, cette playlist n'existe plus."

#: jellyfin_alexa_skill/alexa/handler/playlist.py:64
msgid "Ok, I play the playlist {}."
msgstr "D'accord, je lance la playlist {}."

#: jellyfin_alexa_skill/alexa/handler/yesno.py:72
msgid "Hmm. How about <break/> {title} {by_artist} ?"
msgstr "Hmm. Que diriez-vous de <break/> {title} {by_artist} ?"

#: jellyfin_alexa_skill/alexa/handler/yesno.py:78
msgid "I'm all out of guesses.  Please try asking a different way."
msgstr "Je n'ai plus de suggestion. Veuillez formuler votre demande différemment."
